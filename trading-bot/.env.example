# ============================================================
# Phantom Solana Trading Bot - environment configuration
# Copy to .env and fill in. NEVER commit .env or share your key.
# ============================================================

# --- Wallet -------------------------------------------------
# Private key of the DEDICATED BOT WALLET.
# Phantom: Settings -> Manage Accounts -> (account) -> Show Private Key (base58 string)
# A JSON byte array (solana-keygen format) is also accepted.
# Recommended: create a fresh wallet with `npm run wallet:new`, import it into
# Phantom to watch it, and fund it only with what you are willing to risk.
PRIVATE_KEY=

# --- RPC ----------------------------------------------------
# Public RPC works for testing but is rate-limited and slow. For live trading use
# a dedicated RPC (Helius, QuickNode, Triton, etc.).
RPC_URL=https://api.mainnet-beta.solana.com
# Optional: separate websocket endpoint (defaults to RPC_URL with wss://)
# RPC_WS_URL=

# --- Jupiter ------------------------------------------------
# Free key from https://portal.jup.ag . Without a key the bot falls back to
# lite-api.jup.ag which Jupiter is sunsetting and which rate-limits aggressively.
JUPITER_API_KEY=

# --- Mode ---------------------------------------------------
# paper = simulate fills, no real transactions. live = real money.
MODE=paper
# Live trading refuses to start unless this is exactly "yes".
I_UNDERSTAND_THE_RISKS=no

# --- Optional notifications --------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Control panel ------------------------------------------
# The bot serves a browser dashboard at http://localhost:8787 when it runs.
PANEL_PORT=8787
# Only expose beyond this machine together with a token, e.g. to open it from your phone on the same Wi-Fi:
# PANEL_HOST=0.0.0.0
# PANEL_TOKEN=choose-a-long-random-secret   (then open http://<pc-ip>:8787/?token=...)
# PANEL=off                                  disables the panel

# --- Encrypted key (alternative to PRIVATE_KEY) -----------
# Run `npm run wallet:encrypt` to create data/wallet.enc, then leave PRIVATE_KEY empty.
# The bot prompts for the password at start, or reads it from:
# WALLET_PASSWORD=

# --- Optional ----------------------------------------------
# CONFIG_PATH=./config.yaml
# LOG_LEVEL=info          # debug | info | warn | error
# DB_PATH=./data/bot.db
